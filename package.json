{
  "name": "clipper-studio",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "predev": "node scripts/copy-ffmpeg-core.mjs && node scripts/copy-tts-assets.mjs",
    "prebuild": "node scripts/copy-ffmpeg-core.mjs && node scripts/copy-tts-assets.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/clipper.mjs && node e2e/motion.mjs && node e2e/transcript.mjs && node e2e/seo.mjs && node e2e/editing.mjs",
    "remotion:studio": "remotion studio remotion/index.ts",
    "render:motion": "remotion render remotion/index.ts MotionGraphics30 out/motion-graphics.mp4",
    "render:script": "remotion render remotion/index.ts ScriptVideo out/script-video.mp4 --props=props.json",
    "pretest": "node scripts/copy-tts-assets.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@huggingface/transformers": "4.3.1",
    "@remotion/media": "4.0.538",
    "@remotion/player": "4.0.538",
    "@remotion/web-renderer": "4.0.538",
    "lucide": "1.61.0",
    "next": "15.5.28",
    "onnxruntime-web": "1.30.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "remotion": "4.0.538",
    "sharp": "0.35.5",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@3sln/donki-lle-voice-multi": "0.1.1",
    "@3sln/donki-lle-voice-multi-2": "0.1.1",
    "@3sln/donki-lle-voice-multi-3": "0.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "typescript": "^5.8.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
